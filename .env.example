# Neon PostgreSQL
DATABASE_URL=

# V6 admin access (generate a random password and a random secret of 32+ chars)
V6_ADMIN_PASSWORD=
V6_SESSION_SECRET=

# OpenAI — server-side only
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-6.2-sol
OPENAI_GENERATION_MODEL=

# Metricool API is NOT required. V6 imports Metricool exports / prepared JSON files.
